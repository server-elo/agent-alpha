# Copy to .env and edit. Everything here is optional.
# Defaults to Ollama on localhost, which needs no key.

# --- model ---------------------------------------------------------------
# A preset name (see `alpha --providers`), or leave unset and use ALPHA_BASE_URL.
#ALPHA_PROVIDER=ollama
#ALPHA_MODEL=qwen2.5-coder:7b

# Any OpenAI-compatible endpoint. Overrides the preset's URL.
#ALPHA_BASE_URL=http://localhost:11434/v1

# Only for hosted providers. Provider-specific variables such as
# OPENAI_API_KEY or ANTHROPIC_API_KEY are picked up automatically.
#ALPHA_API_KEY=

# --- behaviour -----------------------------------------------------------
#ALPHA_CWD=/path/to/your/project
#ALPHA_MAX_TURNS=24
#ALPHA_STREAM=1

# --- telegram (optional) -------------------------------------------------
# The bot refuses to start without an allowlist: the tools are unsandboxed and
# a bot token is a public endpoint. Use "*" only if you really mean everyone.
#ALPHA_TELEGRAM_BOT_TOKEN=
#ALPHA_TELEGRAM_ALLOW=

# --- voice notes (optional) ----------------------------------------------
#ALPHA_VOICE_MODEL=medium
#ALPHA_VOICE_LANG=en
#ALPHA_VOICE_PROMPT=
